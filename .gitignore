# ---- Python (backend) ----
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
# Collected desktop installers land in the repo-root dist/ (anchored so it does
# NOT match desktop/dist/, which is the shell's splash-page SOURCE).
/dist/

# ---- Node (frontend) ----
frontend/node_modules/
# frontend/dist/ is COMMITTED on purpose: the installed app is a git checkout that
# updates itself with `git pull`, so the built UI must travel with the source
# (tests/test_frontend_dist.py keeps it in step with frontend/src).
frontend/.vite/
npm-debug.log*
yarn-error.log*

# ---- Runtime data (per-deployment; never committed) ----
data/*
!data/.gitkeep
*.db
*.db-wal
*.db-shm
.storage_secret
# utils/config.py reads APP_DIR/.env for provider keys; a committed one would ship
# in the installer's git history forever.
.env
# The engine's default output folder (utils/config.py: assets/finished, assets/temp);
# every render would otherwise dirty the installed checkout.
/assets/

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# ---- Installed-app overlays (the install is a git checkout of this repo; these
# are staged in by desktop/scripts/stage-app.ps1 and must not dirty `git status`
# there) ----
/bin/
/boot.py

# ---- Desktop shell (Tauri): vendored runtime, staged app tree, Rust build ----
desktop/node_modules/
desktop/src-tauri/vendor/
desktop/src-tauri/target/
desktop/src-tauri/gen/
