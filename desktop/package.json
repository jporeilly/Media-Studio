{
  "name": "media-studio-desktop",
  "version": "0.8.0",
  "private": true,
  "description": "Windows desktop shell for Media Studio Enterprise",
  "scripts": {
    "build:frontend": "npm --prefix ../frontend run build",
    "fetch:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-python.ps1",
    "stage:app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-app.ps1",
    "icons": "python scripts/make-icons.py",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-environment.ps1",
    "collect": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/collect-installer.ps1",
    "dist": "npm run build:frontend && npm run fetch:python && npm run stage:app && npm run tauri:build && npm run collect"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
