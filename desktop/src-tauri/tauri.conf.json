{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Media-Studio-Enterprise",
  "version": "0.11.0",
  "identifier": "com.pentaho.media-studio",
  "build": {
    "beforeBuildCommand": "npm run fetch:python && npm run fetch:ffprobe && npm run stage:app",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Media Studio Enterprise",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/python": "python",
      "vendor/app": "app",
      "../scripts/lib/common.ps1": "provisioning/lib/common.ps1",
      "../scripts/check-environment.ps1": "provisioning/check-environment.ps1"
    },
    "category": "Productivity",
    "shortDescription": "Turn PowerPoint decks into narrated videos",
    "longDescription": "Media Studio Enterprise imports PowerPoint decks and speaker notes, generates narration with free or premium text-to-speech, and renders finished narrated videos - all on the local machine.",
    "publisher": "Pentaho Presales Engineering",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      },
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/sign.ps1 %1"
    }
  },
  "plugins": {}
}
